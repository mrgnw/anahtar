{
  "name": "@mrgnw/anahtar",
  "version": "0.5.0-beta.1",
  "description": "Opinionated, reusable auth for SvelteKit. Email+OTP + passkeys.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrgnw/anahtar.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --config vitest.unit.ts && vitest run --config vitest.browser.ts",
    "test:unit": "vitest run --config vitest.unit.ts",
    "test:browser": "vitest run --config vitest.browser.ts",
    "prepublishOnly": "pnpm build"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/db/sqlite.d.ts",
      "default": "./dist/db/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/db/postgres.d.ts",
      "default": "./dist/db/postgres.js"
    },
    "./d1": {
      "types": "./dist/db/d1.d.ts",
      "default": "./dist/db/d1.js"
    },
    "./device": {
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "svelte": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "peerDependencies": {
    "@simplewebauthn/browser": "^13.0.0 || ^14.0.0",
    "@sveltejs/kit": "^2.0.0 || ^3.0.0-next.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "@simplewebauthn/browser": {
      "optional": true
    }
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^13.2.0",
    "happy-dom": "^21.0.4",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
